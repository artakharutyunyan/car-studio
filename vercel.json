{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/vercel",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/cars/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/formula-1",
      "destination": "/index.html"
    }
  ]
}
